  <default>
    <geom density="0"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" density="0"/>
    </default>
    <default class="collision">
      <geom group="3" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001" density="0"/>
    </default>
    <default class="wheel">
      <geom group="3" contype="1" conaffinity="1" condim="3" friction="1.2 0.005 0.0001" density="0"/>
    </default>
    <default class="finger_pad">
      <geom group="3" contype="1" conaffinity="1" condim="4" friction="1.0 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001" density="0"/>
    </default>
    <default class="sensor_collision">
      <geom group="4" contype="1" conaffinity="1" density="0"/>
    </default>
  </default>
  <asset/>
  <worldbody>
    <body name="imu_link">
      <geom class="visual" type="box" size="0.015 0.015 0.005"/>
      <geom class="sensor_collision" type="box" size="0.015 0.015 0.005"/>
      <site name="imu_sensor_frame" size="0.002"/>
    </body>
  </worldbody>
</mujoco>
